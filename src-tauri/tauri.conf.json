{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimplySoundboard",
  "version": "0.1.0",
  "identifier": "dev.simplysoundboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SimplySoundboard",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Soundboard with global hotkeys and a virtual microphone",
    "longDescription": "Plays sounds into a virtual microphone so voice chat hears them, with global hotkeys that work inside games.",
    "linux": {
      "deb": {
        "depends": [
          "pipewire-pulse",
          "pulseaudio-utils",
          "pipewire-bin"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-simplysoundboard-input.rules": "../packaging/70-simplysoundboard-input.rules"
        },
        "postInstallScript": "../packaging/postinst.sh"
      },
      "rpm": {
        "depends": [
          "pipewire-pulseaudio",
          "pulseaudio-utils",
          "pipewire-utils"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-simplysoundboard-input.rules": "../packaging/70-simplysoundboard-input.rules"
        },
        "postInstallScript": "../packaging/postinst.sh"
      }
    }
  }
}
